# ---- Server ----
NODE_ENV=development
PORT=8800
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Use 127.0.0.1 (IPv4) rather than "localhost" to avoid IPv6 (::1) resolution
# timeouts on Windows when MySQL is bound to the IPv4 loopback.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=mydevify_social

# ---- Auth ----
# Generate a long random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- Email (OTP verification) ----
# For Gmail, create an App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
